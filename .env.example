# MongoDB must run as a replica set for Prisma (Atlas does by default).
# Local development (npm run db):
DATABASE_URL="mongodb://127.0.0.1:27018/stubble?replicaSet=testset&directConnection=true"
# Hosted (MongoDB Atlas): mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/stubble?retryWrites=true&w=majority

# NASA FIRMS key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=""

# Random string used to sign login cookies (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=""
